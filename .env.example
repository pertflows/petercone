# ── Site ─────────────────────────────────────────────────────────────
# Public URL used in invitation links, calendar files and share previews.
NEXT_PUBLIC_SITE_URL=https://emilyandjoe.example.com

# ── Supabase (required in production) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin portal ────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin (in addition to public.admin_users).
ADMIN_EMAILS=
# 32+ random characters. Signs local admin sessions.
SESSION_SECRET=
# Local development only (when Supabase is not configured). Defaults to "perticone" in dev.
ADMIN_PASSWORD=
